generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../client/dados.db"
}

model User {
  id Int @id @default(autoincrement())
  nome String
  nickname String?
  email String @unique
  password String
  administrator Boolean
  createdAt DateTime @default(now())
}

model prnindices {
  id        Int    @id @default(autoincrement())
  prn       Int
  mediasnr  Float?
  mediaazi  Float?
  mediaelev Float?
  tinicial  String
  tfinal    String
  dpsnr     Float?
  s4        Float
}

model prninfo {
  id   Int    @id @default(autoincrement())
  time String
  prn  Int
  snr  Float?
  azi  Float?
  elev Float?
  lat  Float?
  long Float?
}
